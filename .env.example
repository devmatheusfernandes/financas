# Neon: use a connection string "pooled" (…-pooler…) com sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL pública do app (ex.: https://financas.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# IA (opcional). Sem ANTHROPIC_API_KEY o app usa um interpretador por palavras-chave.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
# Transcrição de áudio (opcional). Sem ela o modo Áudio fica desativado.
OPENAI_API_KEY=
